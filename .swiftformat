--swiftversion 6.0
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--commas always
--self remove
--stripunusedargs closure-only
--exclude .build,Generated,Sources/SuwopShell/Generated,DerivedData,target

--elseposition same-line

--semicolons never
--wrapcollections before-first
