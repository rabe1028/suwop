#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Lint checks this working tree. Staged scanners in the user's managed hook
# have already run; do not leak its alternate index or Git paths to dependencies.
while IFS= read -r variable; do
  unset "$variable"
done < <(git rev-parse --local-env-vars)
make lint
